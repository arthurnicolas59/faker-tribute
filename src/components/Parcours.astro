---
import { getCollection } from "astro:content";
import { textesDuSite } from "../data/site";

// Les étapes sont rangées par année, quel que soit leur ordre dans le fichier.
const etapes = (await getCollection("parcours")).sort((a, b) => a.data.annee - b.data.annee);
---

<section class="parcours" aria-labelledby="titre-parcours">
  <h2 id="titre-parcours" class="titre-section">{textesDuSite.parcours.titre}</h2>
  <div class="etapes">
    {
      etapes.map(({ data }) => (
        <article class="etape">
          <h3 class="etape-titre">
            <time class="annee" datetime={String(data.annee)}>
              {data.annee}
            </time>
            {data.titre}
          </h3>
          <p>{data.texte}</p>
        </article>
      ))
    }
  </div>
</section>

<style>
  .parcours {
    max-width: calc(var(--largeur-texte) + 2 * var(--marge-laterale));
    margin: 0 auto;
    padding: 4rem var(--marge-laterale);
  }

  .titre-section {
    margin: 0 0 2.5rem;
    padding-bottom: 0.75rem;
    color: var(--couleur-or);
    font-size: var(--taille-titre-section);
    border-bottom: 2px solid var(--couleur-rouge);
  }

  .etapes {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .etape {
    padding-left: 1rem;
    border-left: 1px solid var(--couleur-rouge-sombre);
  }

  .etape-titre {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    margin: 0 0 0.5rem;
    font-size: var(--taille-titre-etape);
  }

  .annee {
    color: var(--couleur-or);
    font-variant-numeric: tabular-nums;
  }

  .etape p {
    margin: 0;
    color: var(--couleur-texte-doux);
  }
</style>
