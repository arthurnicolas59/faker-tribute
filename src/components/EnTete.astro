---
import { textesDuSite } from "../data/site";
import { delaisApparition } from "../scripts/delais-lettres";

const { nom, surnom, accroche } = textesDuSite.enTete;
const lettres = [...nom];
const delais = delaisApparition(lettres.length);
---

<header class="en-tete">
  <p class="surnom">{surnom}</p>
  <!-- Les lettres sont cachées aux lecteurs d'écran : l'aria-label du h1 annonce « Faker » d'un bloc. -->
  <h1 class="nom" aria-label={nom}>
    {lettres.map((lettre, i) => (
      <span class="lettre" aria-hidden="true" style={`--delai: ${delais[i]}s`}>{lettre}</span>
    ))}
  </h1>
  <p class="accroche">{accroche}</p>
</header>

<style>
  .en-tete {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    min-height: 100vh;
    min-height: 100svh;
    padding: 4rem var(--marge-laterale);
    text-align: center;
    overflow: hidden;
    background:
      radial-gradient(ellipse 70% 55% at 50% 45%, var(--couleur-rouge-sombre), transparent 70%),
      linear-gradient(180deg, var(--couleur-noir) 0%, var(--couleur-noir-doux) 100%);
    border-bottom: 1px solid var(--couleur-or);
  }

  /* Deux filets dorés, comme le cadre d'une affiche. */
  .en-tete::before,
  .en-tete::after {
    content: "";
    position: absolute;
    left: 50%;
    width: min(18rem, 60%);
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--couleur-or), transparent);
    transform: translateX(-50%);
  }

  .en-tete::before {
    top: 2.5rem;
  }

  .en-tete::after {
    bottom: 2.5rem;
  }

  .surnom {
    margin: 0;
    color: var(--couleur-or);
    font-family: var(--police-titre);
    font-size: var(--taille-surtitre);
    font-weight: var(--graisse-titre);
    letter-spacing: var(--interlettrage-surtitre);
    text-transform: uppercase;
  }

  .nom {
    margin: 0;
    font-size: var(--taille-geant);
    color: var(--couleur-texte);
    white-space: nowrap;
    text-shadow:
      0 0 0.35em color-mix(in srgb, var(--couleur-rouge) 70%, transparent),
      0 0.04em 0 var(--couleur-rouge);
  }

  /* Par défaut (et avec « réduire les animations ») le nom est entier, sans mouvement.
     Seul l'opacity et le text-shadow bougent : le nom ne change ni de place ni de taille. */
  @media screen and (prefers-reduced-motion: no-preference) {
    .lettre {
      animation: lettre-apparait 0.5s ease-out var(--delai) both;
    }

    /* La pulsation démarre quand la dernière lettre est apparue (1,5 s au plus). */
    .nom {
      animation: lueur-respire 3.5s ease-in-out 1.5s infinite;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nom,
    .lettre {
      animation: none;
    }
  }

  @keyframes lettre-apparait {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  @keyframes lueur-respire {
    0%,
    100% {
      text-shadow:
        0 0 0.2em color-mix(in srgb, var(--couleur-rouge) 40%, transparent),
        0 0.04em 0 var(--couleur-rouge);
    }

    50% {
      text-shadow:
        0 0 0.45em color-mix(in srgb, var(--couleur-rouge) 85%, transparent),
        0 0.04em 0 var(--couleur-rouge);
    }
  }

  .accroche {
    max-width: 34rem;
    margin: 0;
    color: var(--couleur-texte-doux);
  }
</style>
